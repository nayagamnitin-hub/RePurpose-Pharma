# Copy this file to ".env" and fill in values. .env is git-ignored.

# --- NCBI E-utilities ---
# Optional but recommended: raises rate limit from 3 to 10 requests/sec.
# Get a free key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# NCBI asks that you identify your tool + contact email in requests.
NCBI_TOOL=ai-drug-repurposing
NCBI_EMAIL=subbu.g@gmail.com

# --- LLM provider (provider-agnostic) ---
# Supported values: "none", "groq", "gemini", "ollama"
LLM_PROVIDER=groq
# Groq (free, fast): https://console.groq.com/keys  (key starts "gsk_")
# Gemini: https://aistudio.google.com/apikey         (key starts "AIza")
LLM_API_KEY=
# Optional; groq defaults to llama-3.3-70b-versatile, gemini to gemini-2.0-flash
LLM_MODEL=
# For local Ollama only, e.g. http://localhost:11434
LLM_BASE_URL=
